<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011"
	xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
	<Metadata>
		<Identity Language="en-US" Id="live-uml-evo" Version="2.0.5" Publisher="bitlab" />
		<DisplayName>Live Uml Evo</DisplayName>
		<Description xml:space="preserve">Live PlantUML flowchart, sequence diagram, state machine and class diagram for C, C++, Java, JavaScript, TypeScript, and Python code</Description>
		<Tags>mermaid,PlantUML,UML,flowchart,sequence diagram,class diagram,state machine
			diagram,instant diagram,live
			diagram,visualization,C,C++,Java,Python,JavaScript,TypeScript,code visualization,diagram
			generator,real-time diagram,c,cpp,java,javascript,typescript,typescriptreact,python,c++</Tags>
		<Categories>Visualization,Programming Languages</Categories>
		<GalleryFlags>Public</GalleryFlags>

		<Properties>
			<Property Id="Microsoft.VisualStudio.Code.Engine" Value="^1.60.0" />
			<Property Id="Microsoft.VisualStudio.Code.ExtensionDependencies" Value="" />
			<Property Id="Microsoft.VisualStudio.Code.ExtensionPack" Value="" />
			<Property Id="Microsoft.VisualStudio.Code.ExtensionKind" Value="workspace" />
			<Property Id="Microsoft.VisualStudio.Code.LocalizedLanguages" Value="" />
			<Property Id="Microsoft.VisualStudio.Code.EnabledApiProposals" Value="" />

			<Property Id="Microsoft.VisualStudio.Code.ExecutesCode" Value="true" />

			<Property Id="Microsoft.VisualStudio.Services.Links.Source"
				Value="https://github.com/codenaveed/liveuml.git" />
			<Property Id="Microsoft.VisualStudio.Services.Links.Getstarted"
				Value="https://github.com/codenaveed/liveuml.git" />
			<Property Id="Microsoft.VisualStudio.Services.Links.GitHub"
				Value="https://github.com/codenaveed/liveuml.git" />
			<Property Id="Microsoft.VisualStudio.Services.Links.Support"
				Value="https://github.com/codenaveed/liveuml/issues" />
			<Property Id="Microsoft.VisualStudio.Services.Links.Learn"
				Value="https://github.com/codenaveed/liveuml#readme" />


			<Property Id="Microsoft.VisualStudio.Services.GitHubFlavoredMarkdown" Value="true" />
			<Property Id="Microsoft.VisualStudio.Services.Content.Pricing" Value="Free" />


		</Properties>
		<License>extension/LICENSE.txt</License>
		<Icon>extension/icon.png</Icon>
	</Metadata>
	<Installation>
		<InstallationTarget Id="Microsoft.VisualStudio.Code" />
	</Installation>
	<Dependencies />
	<Assets>
		<Asset Type="Microsoft.VisualStudio.Code.Manifest" Path="extension/package.json"
			Addressable="true" />
		<Asset Type="Microsoft.VisualStudio.Services.Content.Details" Path="extension/readme.md"
			Addressable="true" />
		<Asset Type="Microsoft.VisualStudio.Services.Content.Changelog"
			Path="extension/changelog.md" Addressable="true" />
		<Asset Type="Microsoft.VisualStudio.Services.Content.License" Path="extension/LICENSE.txt"
			Addressable="true" />
		<Asset Type="Microsoft.VisualStudio.Services.Icons.Default" Path="extension/icon.png"
			Addressable="true" />
	</Assets>
</PackageManifest>